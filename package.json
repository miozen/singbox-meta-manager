{
  "name": "singbox-meta-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Sing-box Meta Manager - 云端全栈配置管理中心",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "build:frontend": "pnpm --filter frontend build",
    "deploy:worker": "pnpm --filter worker run deploy",
    "cf:build": "pnpm run build:frontend",
    "cf:deploy": "pnpm run deploy:worker",
    "cf:publish": "pnpm run cf:build && pnpm run cf:deploy"
  }
}
